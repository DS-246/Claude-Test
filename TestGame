<!DOCTYPE html>
\n<html lang=\"en\">
\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Turn-Based Battle</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n\n    body {\n      background: #1a1a2e;\n      color: #eee;\n      font-family: 'Courier New', monospace;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n    }\n\n    .game {\n      width: 640px;\n      padding: 24px;\n    }\n\n    h1 {\n      text-align: center;\n      color: #e94560;\n      font-size: 2rem;\n      letter-spacing: 4px;\n      margin-bottom: 24px;\n      text-shadow: 0 0 10px #e94560;\n    }\n\n    .arena {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      gap: 16px;\n      margin-bottom: 24px;\n    }\n\n    .fighter {\n      flex: 1;\n      background: #16213e;\n      border: 2px solid #0f3460;\n      border-radius: 12px;\n      padding: 16px;\n      text-align: center;\n      transition: border-color 0.3s;\n    }\n\n    .fighter.active {\n      border-color: #e94560;\n      box-shadow: 0 0 12px rgba(233, 69, 96, 0.4);\n    }\n\n    .fighter.enemy { flex-direction: row-reverse; }\n\n    .fighter-sprite {\n      font-size: 4rem;\n      margin-bottom: 8px;\n      display: block;\n      transition: transform 0.15s;\n    }\n\n    .fighter.shake .fighter-sprite { animation: shake 0.3s; }\n    @keyframes shake {\n      0%,100% { transform: translateX(0); }\n      25% { transform: translateX(-8px); }\n      75% { transform: translateX(8px); }\n    }\n\n    .fighter-name {\n      font-size: 1rem;\n      font-weight: bold;\n      color: #a8dadc;\n      margin-bottom: 8px;\n    }\n\n    .hp-label {\n      font-size: 0.75rem;\n      color: #999;\n      margin-bottom: 4px;\n    }\n\n    .hp-bar {\n      background: #333;\n      border-radius: 6px;\n      height: 14px;\n      overflow: hidden;\n      margin-bottom: 6px;\n    }\n\n    .hp-fill {\n      height: 100%;\n      border-radius: 6px;\n      transition: width 0.4s ease, background 0.4s;\n    }\n\n    .hp-fill.high   { background: #4caf50; }\n    .hp-fill.medium { background: #ff9800; }\n    .hp-fill.low    { background: #f44336; }\n\n    .hp-text {\n      font-size: 0.8rem;\n      color: #ccc;\n    }\n\n    .vs {\n      font-size: 2rem;\n      font-weight: bold;\n      color: #0f3460;\n      flex-shrink: 0;\n    }\n\n    .log {\n      background: #0d0d1a;\n      border: 1px solid #0f3460;\n      border-radius: 8px;\n      padding: 12px;\n      height: 140px;\n      overflow-y: auto;\n      font-size: 0.85rem;\n      line-height: 1.6;\n      margin-bottom: 20px;\n      scroll-behavior: smooth;\n    }\n\n    .log p { margin-bottom: 2px; }\n    .log .dmg  { color: #e94560; }\n    .log .heal { color: #4caf50; }\n    .log .info { color: #a8dadc; }\n    .log .sys  { color: #888; }\n\n    .actions {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n      margin-bottom: 16px;\n    }\n\n    button {\n      background: #16213e;\n      border: 2px solid #0f3460;\n      color: #eee;\n      padding: 12px 8px;\n      border-radius: 8px;\n      font-family: inherit;\n      font-size: 0.9rem;\n      cursor: pointer;\n      transition: all 0.2s;\n    }\n\n    button:hover:not(:disabled) {\n      background: #0f3460;\n      border-color: #e94560;\n      color: #fff;\n    }\n\n    button:disabled {\n      opacity: 0.4;\n      cursor: not-allowed;\n    }\n\n    #restart {\n      width: 100%;\n      background: #e94560;\n      border-color: #e94560;\n      color: #fff;\n      font-weight: bold;\n      letter-spacing: 2px;\n      display: none;\n    }\n\n    #restart:hover { background: #c73652; }\n\n    .turn-indicator {\n      text-align: center;\n      font-size: 0.8rem;\n      color: #888;\n      margin-bottom: 12px;\n      letter-spacing: 1px;\n    }\n\n    .turn-indicator span { color: #a8dadc; font-weight: bold; }\n  </style>\n</head>\n<body>\n<div class=\"game\">\n  <h1>⚔ BATTLE ⚔</h1>\n\n  <div class=\"arena\">\n    <div class=\"fighter\" id=\"player-card\">\n      <span class=\"fighter-sprite\">🧙</span>\n      <div class=\"fighter-name\">MAGE</div>\n      <div class=\"hp-label\">HP</div>\n      <div class=\"hp-bar\"><div class=\"hp-fill high\" id=\"player-hp-bar\" style=\"width:100%\"></div></div>\n      <div class=\"hp-text\" id=\"player-hp-text\">100 / 100</div>\n    </div>\n\n    <div class=\"vs\">VS</div>\n\n    <div class=\"fighter enemy\" id=\"enemy-card\">\n      <span class=\"fighter-sprite\">🐉</span>\n      <div class=\"fighter-name\">DRAGON</div>\n      <div class=\"hp-label\">HP</div>\n      <div class=\"hp-bar\"><div class=\"hp-fill high\" id=\"enemy-hp-bar\" style=\"width:100%\"></div></div>\n      <div class=\"hp-text\" id=\"enemy-hp-text\">120 / 120</div>\n    </div>\n  </div>\n\n  <div class=\"turn-indicator\">Turn <span id=\"turn-num\">1</span> — <span id=\"whose-turn\">Your move</span></div>\n\n  <div class=\"log\" id=\"log\">\n    <p class=\"info\">⚔ A dragon blocks your path! Prepare for battle!</p>\n  </div>\n\n  <div class=\"actions\">\n    <button onclick=\"action('attack')\"  id=\"btn-attack\">⚔ Attack<br><small>15–25 dmg</small></button>\n    <button onclick=\"action('heavy')\"   id=\"btn-heavy\">💥 Heavy Strike<br><small>25–40 dmg, 60% hit</small></button>\n    <button onclick=\"action('heal')\"    id=\"btn-heal\">💚 Heal<br><small>restore 20–30 HP</small></button>\n    <button onclick=\"action('shield')\"  id=\"btn-shield\">🛡 Shield Up<br><small>block next hit</small></button>\n  </div>\n\n  <button id=\"restart\" onclick=\"init()\">↺ PLAY AGAIN</button>\n</div>\n\n<script>\n  const state = {\n    player: { hp: 100, maxHp: 100, shield: false },\n    enemy:  { hp: 120, maxHp: 120, shield: false },\n    turn: 1,\n    playerTurn: true,\n    over: false\n  };\n\n  function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }\n\n  function log(msg, cls = '') {\n    const el = document.getElementById('log');\n    const p = document.createElement('p');\n    if (cls) p.className = cls;\n    p.innerHTML = msg;\n    el.appendChild(p);\n    el.scrollTop = el.scrollHeight;\n  }\n\n  function updateBars() {\n    const { player, enemy } = state;\n    setBar('player', player.hp, player.maxHp);\n    setBar('enemy',  enemy.hp,  enemy.maxHp);\n    document.getElementById('turn-num').textContent = state.turn;\n    document.getElementById('whose-turn').textContent = state.playerTurn ? 'Your move' : 'Dragon\\'s move';\n  }\n\n  function setBar(who, hp, max) {\n    const pct = Math.max(0, hp / max * 100);\n    const bar  = document.getElementById(`${who}-hp-bar`);\n    const text = document.getElementById(`${who}-hp-text`);\n    bar.style.width = pct + '%';\n    bar.className = 'hp-fill ' + (pct > 50 ? 'high' : pct > 25 ? 'medium' : 'low');\n    text.textContent = `${Math.max(0,hp)} / ${max}`;\n  }\n\n  function shake(id) {\n    const el = document.getElementById(id);\n    el.classList.remove('shake');\n    void el.offsetWidth;\n    el.classList.add('shake');\n    setTimeout(() => el.classList.remove('shake'), 400);\n  }\n\n  function setButtons(enabled) {\n    ['btn-attack','btn-heavy','btn-heal','btn-shield'].forEach(id => {\n      document.getElementById(id).disabled = !enabled;\n    });\n  }\n\n  function checkEnd() {\n    if (state.enemy.hp <= 0) {\n      log('🏆 <b>The dragon falls! You are victorious!</b>', 'info');\n      endGame();\n      return true;\n    }\n    if (state.player.hp <= 0) {\n      log('💀 <b>You have been defeated... The dragon roars!</b>', 'dmg');\n      endGame();\n      return true;\n    }\n    return false;\n  }\n\n  function endGame() {\n    state.over = true;\n    setButtons(false);\n    document.getElementById('restart').style.display = 'block';\n  }\n\n  function dealDamage(target, amount) {\n    const t = state[target];\n    if (t.shield) {\n      log(`🛡 ${target === 'enemy' ? 'Dragon' : 'You'} blocked the attack!`, 'info');\n      t.shield = false;\n      return 0;\n    }\n    t.hp -= amount;\n    shake(target === 'enemy' ? 'enemy-card' : 'player-card');\n    return amount;\n  }\n\n  function action(type) {\n    if (!state.playerTurn || state.over) return;\n    setButtons(false);\n\n    const p = state.player;\n    const e = state.enemy;\n\n    if (type === 'attack') {\n      const dmg = rand(15, 25);\n      const dealt = dealDamage('enemy', dmg);\n      log(`⚔ You attack the dragon for <b>${dealt}</b> damage!`, 'dmg');\n    } else if (type === 'heavy') {\n      if (Math.random() < 0.6) {\n        const dmg = rand(25, 40);\n        const dealt = dealDamage('enemy', dmg);\n        log(`💥 Heavy strike hits for <b>${dealt}</b> damage!`, 'dmg');\n      } else {\n        log(`💨 Heavy strike missed!`, 'sys');\n      }\n    } else if (type === 'heal') {\n      const amount = rand(20, 30);\n      p.hp = Math.min(p.maxHp, p.hp + amount);\n      log(`💚 You heal for <b>${amount}</b> HP!`, 'heal');\n    } else if (type === 'shield') {\n      p.shield = true;\n      log(`🛡 You raise your shield — ready to block!`, 'info');\n    }\n\n    updateBars();  \n    if (checkEnd()) return;\n\n    state.playerTurn = false;\n    setTimeout(enemyTurn, 900);\n  }\n\n  function enemyTurn() {\n    if (state.over) return;\n    const p = state.player;\n    const e = state.enemy;\n    const hpPct = e.hp / e.maxHp;\n\n    let choice;\n    if (hpPct < 0.3 && Math.random() < 0.4) {\n      choice = 'shield';\n    } else if (hpPct < 0.5 && Math.random() < 0.3) {\n      choice = 'heavy';\n    } else {\n      choice = Math.random() < 0.7 ? 'attack' : 'heavy';\n    }\n\n    if (choice === 'attack') {\n      const dmg = rand(12, 22);\n      const dealt = dealDamage('player', dmg);\n      log(`🐉 Dragon attacks you for <b>${dealt}</b> damage!`, 'dmg');\n    } else if (choice === 'heavy') {\n      if (Math.random() < 0.6) {\n        const dmg = rand(20, 35);\n        const dealt = dealDamage('player', dmg);\n        log(`🔥 Dragon breathes fire for <b>${dealt}</b> damage!`, 'dmg');\n      } else {\n        log(`🌬 Dragon's fire breath fizzles!`, 'sys');\n      }\n    } else if (choice === 'shield') {\n      e.shield = true;\n      log(`🐉 Dragon coils defensively!`, 'info');\n    }\n\n    updateBars();\n    if (checkEnd()) return;\n\n    state.turn++;\n    state.playerTurn = true;\n    updateBars();\n    setButtons(true);\n    highlightActive();\n  }\n\n  function highlightActive() {\n    document.getElementById('player-card').classList.toggle('active', state.playerTurn);\n    document.getElementById('enemy-card').classList.toggle('active', !state.playerTurn);\n  }\n\n  function init() {\n    state.player = { hp: 100, maxHp: 100, shield: false };\n    state.enemy  = { hp: 120, maxHp: 120, shield: false };\n    state.turn = 1;\n    state.playerTurn = true;\n    state.over = false;\n\n    document.getElementById('log').innerHTML = '<p class=\"info\">⚔ A dragon blocks your path! Prepare for battle!</p>';\n    document.getElementById('restart').style.display = 'none';\n    setButtons(true);\n    updateBars();\n    highlightActive();\n  }\n\n  init();\n</script>\n</body>\n</html>
